FROM node:22-bookworm-slim AS web-build
WORKDIR /app
COPY web/package.json web/package-lock.json ./web/
RUN npm ci --prefix web
COPY web/ ./web/
RUN npm --prefix web run build

FROM python:3.12-slim-bookworm AS api
WORKDIR /app

# Install uv (static binary).
RUN pip install --no-cache-dir uv

# Python deps first for layer cache.
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev

# Runtime files.
COPY studio ./studio
COPY migrations ./migrations
COPY alembic.ini ./

# Built frontend assets.
COPY --from=web-build /app/web/dist ./web/dist

ENV STUDIO_DATABASE_URL=sqlite+pysqlite:////data/studio.db
EXPOSE 10000

CMD ["uv", "run", "python", "-c", "from studio.api.app import create_app; import uvicorn; uvicorn.run(create_app(), host='0.0.0.0', port=10000)"]