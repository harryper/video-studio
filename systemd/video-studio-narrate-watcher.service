[Unit]
Description=Process pending video-studio narrate jobs (TTS + BGM + ffmpeg merge)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/root/opc/video-studio
Environment=PATH=/usr/local/bin:/usr/bin:/bin:/root/opc/video-studio/scripts
ExecStart=/usr/bin/python3 /root/opc/video-studio/scripts/process_video_narrate_jobs.py
